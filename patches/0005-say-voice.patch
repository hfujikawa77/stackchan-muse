diff --git a/esp32/main/noise_control.cpp b/esp32/main/noise_control.cpp
--- a/esp32/main/noise_control.cpp
+++ b/esp32/main/noise_control.cpp
@@ -1733,11 +1733,17 @@
     cJSON *say_required = cJSON_CreateObject();
     cJSON_AddItemToObject(say_required, "text",
                           string_param("What to say, up to 1023 bytes (longer is cut)."));
+    cJSON *say_optional = cJSON_CreateObject();
+    cJSON_AddItemToObject(say_optional, "voice",
+                          string_param("Google Cloud TTS voice name to speak in, e.g. "
+                                       "en-US-Neural2-C; its language comes from the name. "
+                                       "Without it, each sentence is read in the voice for its "
+                                       "language: Japanese, English or Mongolian."));
     add_command(commands, "stackchan.say",
                 "Speak text aloud on Stack-chan now (Google TTS), with the "
                 "speaking face. Not part of the chat. Replies once queued, "
