+                say_required, say_optional);
 #endif
 
 #if CONFIG_HOMEHUB_VOICE
diff --git a/esp32/main/app.c b/esp32/main/app.c
--- a/esp32/main/app.c
+++ b/esp32/main/app.c
@@ -2315,7 +2315,11 @@
         }
         size_t bytes = 0;
         bool truncated = false;
-        if (!stackchan_say_post(text->valuestring, &bytes, &truncated)) {
+        cJSON *voice = cJSON_GetObjectItem(params, "voice");
+        const char *v = cJSON_IsString(voice) && voice->valuestring && voice->valuestring[0]
